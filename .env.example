# OpenAI-compatible endpoint, consumed as {BASE_URL}/chat/completions.
# Examples:
#   OpenRouter:    https://openrouter.ai/api/v1
#   LiteLLM:       http://localhost:4000/v1
#   Ollama local:  http://localhost:11434/v1        (key value ignored)
#   Ollama CLOUD:  https://ollama.com/v1            (key from ollama.com/settings/keys)
KUMITE_BASE_URL=https://ollama.com/v1
KUMITE_API_KEY=oak-PASTE_YOUR_OLLAMA_DOT_COM_KEY_HERE